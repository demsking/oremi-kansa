# Oremi Kànsà Environment Configuration
# ============================================================
# All settings can also be set as environment variables directly.
# Every application setting uses the OREMI_KANSA_ prefix.
# ============================================================

# -- Server Settings -------------------------------------------------------------
# Host address to bind the server to. Use 0.0.0.0 to listen on all interfaces.
OREMI_KANSA_SERVER_HOST=localhost

# Port number to bind the server to. Must be between 1 and 65535.
OREMI_KANSA_SERVER_PORT=5046

# API prefix/root path for deployments behind a reverse proxy.
OREMI_KANSA_API_PREFIX=/

# -- Podcast Index Settings ------------------------------------------------------
# Catalog backend. Use "database" for the local offline SQLite catalog, or "api"
# to query the public Podcast Index API and skip the large startup download.
OREMI_KANSA_CATALOG_BACKEND=database

# Required only when OREMI_KANSA_CATALOG_BACKEND=api.
OREMI_KANSA_PODCAST_INDEX_API_BASE_URL=https://api.podcastindex.org/api/1.0
# OREMI_KANSA_PODCAST_INDEX_API_KEY=
# OREMI_KANSA_PODCAST_INDEX_API_SECRET=

# Offline catalog storage and update schedule. Used when
# OREMI_KANSA_CATALOG_BACKEND=database.
# In clustered deployments, mount the same shared volume in every replica and
# set this path to that mount, usually /oremi/data.
OREMI_KANSA_DATABASE_DOWNLOAD_URL=https://public.podcastindex.org/podcastindex_feeds.db.tgz
OREMI_KANSA_DATA_PATH=data
OREMI_KANSA_DATABASE_AUTO_UPDATE=true
OREMI_KANSA_DATABASE_UPDATE_INTERVAL_HOURS=24
OREMI_KANSA_DATABASE_SEARCH_INDEX_ENABLED=true
OREMI_KANSA_QUERY_CACHE_SIZE=256

# User-Agent sent to Podcast Index. Set a value that identifies your deployment.
OREMI_KANSA_USER_AGENT=oremi-kansa/1.0.0b0

# Explicit HTTP timeout settings in seconds.
OREMI_KANSA_HTTP_CONNECT_TIMEOUT=5
OREMI_KANSA_HTTP_READ_TIMEOUT=15
OREMI_KANSA_HTTP_WRITE_TIMEOUT=5
OREMI_KANSA_HTTP_POOL_TIMEOUT=5

# -- Logging Settings ------------------------------------------------------------
# Logging level. One of: DEBUG, INFO, WARNING, ERROR, CRITICAL.
OREMI_KANSA_LOG_LEVEL=INFO

# Optional rotating log file. Console logging remains enabled when set.
# OREMI_KANSA_LOG_FILE=/var/log/oremi-kansa.log
